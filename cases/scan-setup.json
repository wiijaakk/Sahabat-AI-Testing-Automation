{
  "id": "scan-setup",
  "title": "SETUP scan account: project with a file, and an AI creation",
  "steps": [
    { "action": "gotoDashboard" },
    { "action": "dismiss", "target": "Skip" },
    { "action": "tap", "target": "AIStorage" },
    { "action": "tap", "target": "Create Project" },
    { "action": "type", "target": "Project Name", "text": "SANITY_SCAN_PROJECT" },
    { "action": "tap", "target": "Create Project Confirm" },
    { "action": "seeText", "text": "SANITY_SCAN_PROJECT" },
    { "action": "tapText", "text": "SANITY_SCAN_PROJECT" },
    { "action": "tap", "target": "Upload Files" },
    { "action": "upload", "target": "Add Files Photos", "text": "test-data/SANITY_SCAN_FILE.pdf" },
    { "action": "seeText", "text": "SANITY_SCAN_FILE" },
    { "action": "tap", "target": "Close Modal" },
    { "action": "checkpoint", "target": "scan-project-ready" },
    { "action": "gotoDashboard" },
    { "action": "dismiss", "target": "Skip" },
    { "action": "tap", "target": "New Chat" },
    { "action": "type", "target": "composer", "text": "Buat file CSV bernama SANITY_SCAN_CREATION berisi 3 baris contoh." },
    { "action": "press", "key": "Enter" },
    { "action": "waitReply" },
    { "action": "checkpoint", "target": "scan-creation-asked" },
    { "action": "tap", "target": "Library" },
    { "action": "tap", "target": "AI Creations" },
    { "action": "seeText", "text": "SANITY-SCAN-CREATION" }
  ]
}
