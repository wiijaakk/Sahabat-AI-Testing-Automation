# Optional. OCR handles text names like Library without this.
# Vision is only for icon-only widgets and OCR misses.
GEMINI_API_KEY=

# Used by the operator server. You usually do not need to touch these.
SAHABAT_BASE_URL=https://chat.sahabat-ai.com
SAHABAT_BROWSER_CHANNEL=chrome
OPERATOR_PORT=8787

# Device pixels per CSS px for evidence screenshots (1 or 2).
SAHABAT_SHOT_DPR=2

# Optional. CSS px rects "x,y,w,h;x,y,w,h" painted over in evidence screenshots (account phone number etc).
SAHABAT_REDACT=
